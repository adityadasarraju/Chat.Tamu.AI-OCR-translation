{
  "manifest_version": 3,
  "name": "TAMU OCR Translator",
  "version": "1.2.0",
  "description": "Select foreign text on a webpage and translate it into English using TAMU AI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chat-api.tamu.ai/*"
  ],
  "action": {
    "default_title": "TAMU OCR Translator",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
